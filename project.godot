; Engine configuration file.
; Target: Godot 4.7.x. Requested version 4.7.3 was not released at authoring time; validated with 4.7.2-stable.

config_version=5

[application]

config/name="Strike Ops: Frontline"
config/description="Original mobile military FPS MVP inspired by modern mobile shooters. Offline play with bots."
config/version="0.5.1"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

ErrorLog="*res://scripts/autoload/error_log.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
GameDB="*res://scripts/autoload/game_db.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
MatchConfig="*res://scripts/autoload/match_config.gd"
Effects="*res://scripts/autoload/effects.gd"
NetworkManager="*res://scripts/multiplayer/network_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

sensors/enable_gyroscope=true

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="actors"
3d_physics/layer_3="interact"
3d_physics/layer_4="projectiles"

[navigation]

3d/default_cell_size=0.5
3d/default_cell_height=0.25

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
